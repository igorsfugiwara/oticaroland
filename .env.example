# Copie para .env.local e preencha. Nunca versione o .env.local.

# Gemini — usada pelo chatbot e pelos embeddings.
# ATENÇÃO: por ser VITE_, esta chave é embutida no bundle que o navegador baixa,
# ou seja, qualquer visitante consegue extraí-la. Restrinja a chave por domínio
# no Google Cloud Console e acompanhe a cota. O certo, quando der, é mover as
# chamadas para uma função no servidor e deixar a chave só lá.
VITE_GEMINI_API_KEY=

# Firebase — Console → Configurações do projeto → Seus aplicativos → Web.
# Esta config é pública por design; quem protege os dados são as regras do
# Firestore e do Auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
